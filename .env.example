# Optional overrides for docker-compose.yml. Nothing here is required:
# `docker compose up --build` works out of the box with these defaults.
# To override, copy this file to `.env` and edit the values.

POSTGRES_USER=ledger
POSTGRES_PASSWORD=ledger
POSTGRES_DB=ledger

# Host port the API is published on (http://localhost:8000).
API_PORT=8000

LOG_LEVEL=INFO
